+            settings_path = os.path.join(exe_dir, "settings.json")
+            if os.path.exists(settings_path):
+                import json
+                with open(settings_path, "r") as f:
+                    data = json.load(f)
+                    return data.get("theme", "Aquatic")
+        except Exception:
+            pass
+        return "Aquatic"
